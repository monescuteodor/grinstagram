# ---- Mode ----
# paper = bani simulati pe preturi reale (recomandat). live = ordine reale.
MODE=paper
EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h

# ---- Doar pentru live ----
API_KEY=
API_SECRET=
# Trebuie setat exact asa ca botul sa accepte modul live:
LIVE_CONFIRM=

# ---- Paper trading ----
STARTING_BALANCE=1000
FEE_RATE=0.001

# ---- Strategie ----
BUY_THRESHOLD=0.60
SELL_THRESHOLD=0.45
RETRAIN_HOURS=12

# ---- Risc ----
RISK_PER_TRADE=0.01
MAX_POSITION_PCT=0.30
MAX_OPEN_POSITIONS=3
STOP_LOSS_ATR=2.0
TAKE_PROFIT_ATR=4.0
MAX_DRAWDOWN_PCT=0.20
DAILY_LOSS_LIMIT_PCT=0.05

# ---- Notificari Telegram (optional) ----
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
